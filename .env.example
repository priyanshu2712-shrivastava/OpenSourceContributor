# ========================================================
# Open-Source Contribution Matcher & Onboarding Coach
# Server-side Environment Configuration
# ========================================================

# [Optional] GitHub Personal Access Token
# Raises GitHub API rate limits from 60 req/hr to 5,000 req/hr.
# If omitted, the system seamlessly uses cached repositories and demo datasets.
GITHUB_TOKEN=
# [Optional] Groq API Key
# Powers LLaMA 3.3 70B fast inference for codebase localization & coach roadmaps.
# If omitted, the system automatically uses the high-precision Deterministic Heuristic Engine.
GROQ_API_KEY=
GROQ_MODEL=

# Cache Database Path (defaults to local SQLite cache.db)
CACHE_DB_PATH=backend/cache.db
CACHE_EXPIRY_SECONDS=86400
